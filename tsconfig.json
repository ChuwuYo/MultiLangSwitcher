{
	"compilerOptions": {
		"checkJs": true,
		"noEmit": true,
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"strict": false,
		"noImplicitAny": false,
		"strictNullChecks": false,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"types": ["chrome"]
	},
	"include": ["**/*.js"],
	"exclude": ["node_modules", "src/shared/vendor", "tests", "scripts", ".codegraph"]
}
