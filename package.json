{
	"name": "multilangswitcher",
	"version": "2.1.1",
	"private": true,
	"description": "Chrome extension for switching Accept-Language headers per domain",
	"type": "module",
	"scripts": {
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome ci .",
		"check:syntax": "node scripts/check-syntax.mjs",
		"check:types": "tsc",
		"build:css": "node scripts/purge-css.mjs",
		"test": "vitest run --passWithNoTests",
		"verify": "biome ci . && tsc && node scripts/check-syntax.mjs && node scripts/validate-manifest.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/chrome": "^0.2.2",
		"jsdom": "^30.0.1",
		"purgecss": "^8.0.0",
		"typescript": "^7.0.2",
		"vitest": "^3.2.6"
	}
}
