{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"organizeImports": { "enabled": false },
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedVariables": "warn",
				"noInvalidUseBeforeDeclaration": "warn",
				"noInnerDeclarations": "warn"
			},
			"suspicious": {
				"noDoubleEquals": "off",
				"noExplicitAny": "off"
			},
			"complexity": {
				"noForEach": "off"
			},
			"style": {
				"noVar": "warn",
				"useConst": "warn",
				"useTemplate": "warn"
			}
		}
	},
	"files": {
		"ignore": ["src/shared/vendor/**", ".codegraph/**", "coverage/**"]
	}
}
